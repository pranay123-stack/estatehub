# ---- Database -------------------------------------------------------------
# Local dev: dockerised Postgres (see README "Database setup").
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---- Auth -----------------------------------------------------------------
# 32+ byte secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Session lifetime in days.
AUTH_SESSION_DAYS="7"

# ---- Image storage --------------------------------------------------------
# "local" writes to storage/uploads and serves them via /api/files. Fine for
#   development and self-hosting; NOT on Vercel, whose filesystem is read-only.
# "cloudinary" uploads via the REST API (production).
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
