# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# locally uploaded images (served by /api/files, not from public/)
/storage

# prisma generated client
/src/generated

# test artefacts
/test-results
/playwright-report
/storage/test-uploads

# generated by Next on every `next dev` (set agentRules: false to stop)
/AGENTS.md
/CLAUDE.md
